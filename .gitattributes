# Check out and store text as LF. This overrides Windows core.autocrlf,
# which otherwise marks byte-identical files as modified.
* text=auto eol=lf

*.zip binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.pyd binary
*.so binary
*.whl binary
*.pyc binary
