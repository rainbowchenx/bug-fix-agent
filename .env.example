# Agent-2 cartography / Agent-3 analyze（有凭据时默认 sdk）
# 凭据二选一即可，两者都被认（判定见 bugfix_platform/sdk/credentials.py）：
#
# 注意：Nexas OS 平台会在「模型管理」里把模型注入成 OPENAI_API_KEY /
# OPENAI_BASE_URL / OPENAI_MODEL。本包会自动映射成下面的 ANTHROPIC_*，
# 所以平台上这几行**留空即可**（判定见 bugfix_platform/sdk/model_env.py）。
# 这里填了值就优先用这里的——本地开发想覆盖平台注入的模型时才需要填。
ANTHROPIC_API_KEY=
# Anthropic 兼容网关（DeepSeek 等）通常给 bearer token：填这个就够
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Agent-3 analyze: heuristic | sdk（显式覆盖默认）
BUGFIX_ANALYZE_MODE=

# 单次 run 最多 enrich 几张软定位票（空=不限）
BUGFIX_ANALYZE_LIMIT=

# Agent-3 是否在报告之后跑 worktree 改码（默认关；也可用 --apply-fix）
# BUGFIX_APPLY_FIX=0

# Agent-3 SDK max tool turns（默认 24）
# BUGFIX_ANALYZE_MAX_TURNS=24

# Agent-2 cartography enrich: heuristic | sdk（有 key 时默认 sdk）
BUGFIX_CARTOGRAPHY_MODE=

# Agent-2/3 extra overlay skill roots (os.pathsep-separated; overlay outranks package SOP)
# BUGFIX_SKILLS_DIR=

# Agent-2 SDK turns：空 = 按进 prompt 的匹配池票数预算（base + per×n）；正整数 = 绝对上限；0/unlimited = 不限制
BUGFIX_CARTOGRAPHY_MAX_TURNS=
# 票数预算（仅当 MAX_TURNS 为空时生效）：地图基数 + 每票浅配额（默认 6 + 2×n；n≤16）
BUGFIX_CARTOGRAPHY_BASE_TURNS=
BUGFIX_CARTOGRAPHY_TURNS_PER_TICKET=

# Agent-2 CodeGraph（@colbymchenry/codegraph）：默认开；本地有 .codegraph/ 就用，没有则 codegraph init -y
# BUGFIX_CODEGRAPH=0
# BUGFIX_CODEGRAPH_INIT=0
# CLI 太旧（< 1.6.0，init 不认 -y）时自动 npm i -g latest；0 = 不升，退回老版参数
# BUGFIX_CODEGRAPH_AUTO_UPGRADE=0
# BUGFIX_CODEGRAPH_BIN=/path/to/codegraph
# pytest 默认关掉真实 CodeGraph（每次 spawn init+status 约 30s）；要跑真 CLI 时用 1
# BUGFIX_TEST_CODEGRAPH=1

# SDK trace: summary (default), detailed (live text/tools + full visible JSONL), or off.
# BUGFIX_TRACE=summary

# DeepSeek Anthropic-compatible gateway often also wants:
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]

# S4 HTTP（bugfix-platform serve；默认绑定回环）
# HOST=127.0.0.1
# PORT=8787

# Evidence-quality execution declarations (not verified capabilities).
# BUGFIX_MODEL_CONTEXT_WINDOW=1000000
# BUGFIX_MODEL_MODALITIES=text,image
# Allow selected repository skills without profiles; comma-separated name or repo:name.
# BUGFIX_SKILL_ALLOWLIST=business-verification
# Agent2 sequential groups: 1..16 tickets, default 8.
# BUGFIX_INVESTIGATION_GROUP_SIZE=8
# BUGFIX_INVESTIGATION_MAX_GROUPS=5
# Wall-clock budget checked before each new group; current SDK call may finish later.
# BUGFIX_INVESTIGATION_TIMEOUT_SECONDS=1800
# Optional cache OUTSIDE the business workspace; only complete groups are reusable.
# BUGFIX_INVESTIGATION_CACHE_DIR=/path/to/investigation-cache
