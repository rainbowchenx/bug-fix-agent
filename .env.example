# Agent-3 Claude Agent SDK analyze（有 key 时默认 sdk）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Agent-3 analyze: heuristic | sdk（显式覆盖默认）
BUGFIX_ANALYZE_MODE=

# 单次 run 最多 enrich 几张软定位票（空=不限）
BUGFIX_ANALYZE_LIMIT=

# Agent-2 cartography enrich: heuristic | sdk（有 key 时默认 sdk）
BUGFIX_CARTOGRAPHY_MODE=

# S4 HTTP（bugfix-agent serve；默认绑定回环）
# HOST=127.0.0.1
# PORT=8787

# Agent-2 SDK max tool turns (DeepSeek/Claude Code; default 48)
BUGFIX_CARTOGRAPHY_MAX_TURNS=

# DeepSeek Anthropic-compatible gateway often also wants:
# ANTHROPIC_AUTH_TOKEN=<same as API key>
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
